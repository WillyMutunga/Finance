# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=finance
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_SSLMODE=prefer

# Application Environment & Security
APP_ENV=production
APP_DEBUG=false
APP_SECRET=generate_a_64_character_random_hex_secret_here
CORS_ALLOWED_ORIGINS=*

# Safaricom Daraja M-Pesa API (Production Credentials)
MPESA_ENV=sandbox # change to 'production' for live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_CALLBACK_URL=https://yourdomain.com/api/webhooks/mpesa/stk-callback

# SMS Gateway (Africa's Talking / Advanta / Onfon)
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=SCHOOLFIN